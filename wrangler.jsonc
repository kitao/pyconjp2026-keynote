{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pyconjp2026-keynote",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kitao.dev/pyconjp2026-keynote*", "zone_name": "kitao.dev" }],
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/pyconjp2026-keynote/*.mp4"],
  },
  "build": {
    "command": "node scripts/build.js && node scripts/check.js",
    // Everything the build reads; dist/ itself must stay out, or each build would start another.
    "watch_dir": [
      "package.json",
      "README.md",
      "CREDITS.md",
      "LICENSE",
      "slides.md",
      "theme",
      "assets",
      "pyconjp2026-keynote.pdf",
      "demo/web/pyxel-run.html",
      "tools/slides/hl.py",
      "tools/slides/keys.js",
      "trailer",
      "src",
      "scripts",
    ],
  },
}
